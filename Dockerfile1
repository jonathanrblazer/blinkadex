FROM --platform=linux/arm64 debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        g++ \
        libgpiod-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY src/main.cpp .

RUN apt-get update && apt-get install -y gpiod
RUN g++ -O2 -std=c++17 main.cpp -lgpiod -o gpio-blink

CMD ["./gpio-blink"]
